# Server
APP_ENV=development
SERVER_PORT=8082

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=processing_service_db
DB_SSLMODE=disable

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=raw-videos
MINIO_PROCESSED_BUCKET=processed-videos

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=processing-service
KAFKA_TOPIC_VIDEO_UPLOADED=video.uploaded
KAFKA_TOPIC_VIDEO_PROCESSED=video.processed
KAFKA_TOPIC_VIDEO_FAILED=video.failed

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_THREADS=4

# Worker
WORKER_POOL_SIZE=3
WORKER_MAX_RETRIES=3

# Consul
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_NAME=processing-service
SERVICE_PORT=8082

# JWT
JWT_SECRET=random_string